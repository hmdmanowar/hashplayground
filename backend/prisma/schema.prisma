generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  admin
  user
}

enum FileType {
  file
  folder
}

enum NotificationKind {
  message
  alert
  activity
}

enum FeedbackType {
  bug
  feature
}

enum FeedbackStatus {
  open
  in_progress
  resolved
}

enum PendingUpdateStatus {
  pending
  approved
  rejected
}

model User {
  // Username is the natural key used everywhere today (Project.ownerUsername,
  // Notification.toUsername/fromUsername) and there is no rename-user feature,
  // so it's used directly as the PK instead of adding a surrogate id + join.
  username     String   @id
  // Nullable — an account created via "Continue with Google" has no password
  // at all until they either set one (Settings) or use forgot-password.
  // login() treats a null passwordHash as "password login unavailable".
  passwordHash String?
  role         Role     @default(user)
  name         String?
  email        String?
  // Optional alternate login identifier alongside username — login accepts
  // either. Unique so at most one account can claim a given phone number.
  phone        String?  @unique
  // Google's stable per-account id ("sub" claim). Set once a Google sign-in
  // creates or links this account.
  googleId     String?  @unique
  // GitHub's stable numeric user id (stored as a string), same idea as googleId.
  githubId     String?  @unique
  // LinkedIn's stable per-account id ("sub" claim), same idea as googleId.
  linkedinId   String?  @unique
  blocked      Boolean  @default(false)
  joinedAt     DateTime @default(now())

  projects            Project[]
  sessions            Session[]
  passwordResetTokens PasswordResetToken[]
  feedback            Feedback[]
  feedbackStatusChanges FeedbackStatusChange[] @relation("FeedbackStatusChangeActor")

  @@index([role, blocked])
}

// Forgot-password flow: same hashed-token-in-DB pattern as Session (id = sha256
// of the raw token emailed to the user; only the hash is ever stored). One row
// per request — a fresh request doesn't invalidate an older still-valid one,
// but each token is single-use (deleted on redemption) and short-lived.
model PasswordResetToken {
  id        String   @id
  username  String
  user      User     @relation(fields: [username], references: [username], onDelete: Cascade)
  createdAt DateTime @default(now())
  expiresAt DateTime

  @@index([username])
  @@index([expiresAt])
}

// DB-backed session for the cookie-session auth model. Only a hash of the
// raw token is stored here; the raw token lives only in the httpOnly cookie.
model Session {
  id        String   @id // sha256 hex of the raw cookie token
  username  String
  user      User     @relation(fields: [username], references: [username], onDelete: Cascade)
  createdAt DateTime @default(now())
  expiresAt DateTime

  @@index([username])
  @@index([expiresAt])
}

model Project {
  id            String   @id @default(uuid())
  name          String
  description   String?
  // Free-form label ("Blank React + TypeScript"), not an enum — the template
  // catalog is expected to grow and an enum would force a migration each time.
  template      String
  version       String   @default("0.0.0")
  ownerUsername String
  owner         User     @relation(fields: [ownerUsername], references: [username])
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  files                 ProjectFile[]
  versions              ProjectVersion[]
  exports               ExportRecord[]
  pendingUpdateRequests PendingUpdateRequest[]

  @@index([ownerUsername])
}

model ProjectFile {
  id        String   @id @default(uuid())
  projectId String
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  name      String
  path      String
  content   String   @default("")
  type      FileType @default(file)

  @@unique([projectId, path])
  @@index([projectId])
}

model ProjectVersion {
  id        String   @id @default(uuid())
  projectId String
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  version   String
  createdAt DateTime @default(now())
  // Denormalized full-content snapshot, shape-compatible with the frontend's
  // Pick<ProjectFile,'id'|'name'|'path'|'content'|'type'>[] — nothing in the
  // app ever queries a single file's history across versions, so a fully
  // normalized per-file-per-version table would buy relational flexibility
  // this app doesn't use, at real write/read cost.
  files Json

  @@index([projectId, createdAt])
}

model ExportRecord {
  id            String   @id @default(uuid())
  projectId     String
  project       Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  // Plain string, not a FK to ProjectVersion — a zip can be exported before
  // "Update Project" is ever clicked, i.e. before any ProjectVersion exists.
  version       String
  exportedAt    DateTime @default(now())
  fileSizeBytes Int

  @@index([projectId, exportedAt])
}

// User-submitted bug reports and feature requests, visible to admins as a
// table. `imageData` is a base64 data URL of an optional attached
// screenshot, stored inline rather than in separate object storage — this
// app has no blob storage set up, and feedback volume/size is expected to
// stay low. Capped client- and server-side (~3MB raw) to keep that reasonable.
model Feedback {
  id            String                 @id @default(uuid())
  type          FeedbackType
  message       String
  imageData     String?
  status        FeedbackStatus         @default(open)
  username      String
  user          User                   @relation(fields: [username], references: [username], onDelete: Cascade)
  createdAt     DateTime               @default(now())
  statusHistory FeedbackStatusChange[]

  @@index([createdAt])
}

// One row per status transition (seeded with an initial "open" row at
// submission time), so the admin table can show a full timeline instead of
// just the current status — see AdminFeedback's timeline modal.
model FeedbackStatusChange {
  id            String         @id @default(uuid())
  feedbackId    String
  feedback      Feedback       @relation(fields: [feedbackId], references: [id], onDelete: Cascade)
  status        FeedbackStatus
  changedAt     DateTime       @default(now())
  changedBy     String?
  changedByUser User?          @relation("FeedbackStatusChangeActor", fields: [changedBy], references: [username], onDelete: SetNull)

  @@index([feedbackId, changedAt])
}

// A lower-level admin's request to publish a version for a project they
// don't own — the "pull request" half of the update flow (see
// versions.service.ts's requestUpdate/resolveUpdateRequest). The top admin
// reviews using the same diff already shown in Source Control (current
// files vs. latest version — no separate snapshot stored here) and either
// approves, which publishes the project's current files exactly like a
// direct Update Project, or rejects. Only one request may be pending per
// project at a time.
model PendingUpdateRequest {
  id                  String              @id @default(uuid())
  projectId           String
  project             Project             @relation(fields: [projectId], references: [id], onDelete: Cascade)
  // Plain strings, not FKs to User — same reasoning as Notification's
  // toUsername/fromUsername: a deleted user's past requests should keep
  // showing as-is.
  requestedByUsername String
  status              PendingUpdateStatus @default(pending)
  createdAt           DateTime            @default(now())
  resolvedAt          DateTime?
  resolvedByUsername  String?

  @@index([projectId, status])
}

// Singleton row (id is always 1) holding the entire portfolio page's content
// as JSON, editable by the top admin via the /api/portfolio endpoints. A
// single blob rather than a normalized per-section schema — this content has
// exactly one owner and no relational query needs, so separate tables per
// section would be pure overhead. Falls back to the frontend's hardcoded
// defaults when this row doesn't exist yet.
model PortfolioContent {
  id        Int      @id @default(1)
  data      Json
  updatedAt DateTime @updatedAt
  updatedBy String?
}

model Notification {
  id           String           @id @default(uuid())
  // Plain strings, not FKs to User: toUsername can be the sentinel "all"
  // (no matching User row), and a deleted user's past notifications should
  // keep showing as-is, matching today's behavior.
  toUsername   String
  fromUsername String
  kind         NotificationKind
  message      String
  link         String?
  createdAt    DateTime         @default(now())
  readBy       String[]         @default([])

  @@index([toUsername, createdAt])
}
